        "RT-02": {
          "rule": "调度与专业决定分开",
          "implementation": "route 只定位目标/输入/资源；不生成或删改事件、台词、参考权限。"
        },
        "RT-03": {
          "rule": "信息与资源按需传递",
          "implementation": "每次 route 只返回目标子模块资源；trace 单列实际读取的 schema/registry 摘要和实际原请求版本。"
        },
        "RT-04": {
          "rule": "失败与修复显式",
          "implementation": "diagnostics 指定 blocking/status/repair_target；不自动重试创作，不隐式递归或无限回退。"
        },
        "RT-05": {
          "rule": "重试匹配操作效果",
          "implementation": "只读检查可重试；父接受按提案 ID+规范化摘要精确幂等；创作修订用新 ID 和当前版本。"
        },
        "RT-06": {
          "rule": "调用与变更可追溯",
          "implementation": "call_id、operation_id、request_ids、输入/资源摘要、版本、适用性、时间、结果/错误/幂等记录；read_paths 驱动 stale。"
        }
