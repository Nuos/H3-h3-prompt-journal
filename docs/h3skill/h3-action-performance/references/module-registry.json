        },
        "MD-03": {
          "rule": "唯一字段责任",
          "implementation": {
            "writes": [
              "parent version/receipts/issues/source union; child partitions only through validated proposals"
            ],
            "commit_path": "M4.accept",
            "foreign_change": "仅向责任方发请求，父聚合不重写专业值"
          }
        },
        "MD-04": {
          "rule": "资源与兼容边界",
          "implementation": "Python 3.10+ 标准库、所有运行资源随包，不导入兄弟包；破坏性变化改合同版本并显式迁移。"
        },
        "RT-01": {
          "rule": "路由信息完整",
