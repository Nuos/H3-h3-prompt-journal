          "rule": "专业职责一致",
          "implementation": "ActionPlan 父接受、版本及公开路由；不另写与子模块竞争的专业值。"
        },
        "HC-02": {
          "rule": "变化原因一致",
          "implementation": "父节点负责聚合/版本/拒绝；子节点仅因本分区动作语义改变而修订；领域策略与后端编译分离。"
        },
        "HC-03": {
          "rule": "合理拆分粒度",
          "implementation": "仅三个公开子模块；舞蹈、剑舞、搏斗、表情、视线、持物作为领域策略，不另造公共节点。"
        },
        "LC-01": {
          "rule": "公开最小合同",
          "implementation": {
            "minimum_inputs": [
              "action_brief"
            ],
            "schema": "references/contracts.json",
            "version": "1.0.0",
            "unknown": "缺字段失败；显式 unknown 保留未验证"
          }
        },
        "LC-02": {
          "rule": "共享记录按需读取",
          "implementation": "事件/机制上下文与带基准版本的 readonly_projection，只读保真；唯一分区写入。"
        },
        "LC-03": {
          "rule": "数据来源可替代",
