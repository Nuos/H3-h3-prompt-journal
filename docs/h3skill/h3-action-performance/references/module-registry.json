      "scope": "ActionPlan 父接受、版本及公开路由；不另写与子模块竞争的专业值。",
      "non_goals": [
        "绝对排时 M7",
        "权威状态 M8",
        "空间 M3",
        "摄影 M5",
        "模型标签编译 M11",
        "生成媒体审计 M12"
      ],
      "minimum_inputs": [
        "action_brief"
      ],
      "readonly_inputs": [
        "compatible external context or explicit unknown"
      ],
      "write_scope": [
        "parent version/receipts/issues/source union; child partitions only through validated proposals"
      ],
      "output": "M4State draft",
      "return_to": "caller",
      "acceptance": "accept STATE BATCH --requests ORIGINAL_REQUEST_ARRAY",
      "completion": "已实现的本地合同通过；语义/物理/媒体/全局门槛仍未验证",
      "resources": [
        "references/contracts.json",
        "references/module-registry.json",
        "references/contract-guide.md",
        "references/audit-and-handoff.md",
        "references/h3-label-mapping.md"
      ],
      "route": {
        "in": "M4Request.target=M4",
        "out": "M4.1/M4.2/M4.3 route descriptions; agents are not invoked",
