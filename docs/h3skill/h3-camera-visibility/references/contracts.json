        "shot_id",
        "framing_ref",
        "focus_mode",
        "focus_target",
        "depth_of_field",
        "clear_subjects",
        "focus_changes",
        "optical_basis",
        "focus_assessment",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Movement": {
      "type": "object",
      "properties": {
        "camera_event_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "shot_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "viewpoint_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "framing_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "focus_ref": {
          "$ref": "#/$defs/PlanRef"
        },
