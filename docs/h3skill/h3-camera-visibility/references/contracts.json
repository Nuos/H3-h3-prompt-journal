        },
        "position": {
          "$ref": "#/$defs/Fact"
        },
        "height": {
          "$ref": "#/$defs/Fact"
        },
        "distance": {
          "$ref": "#/$defs/Fact"
        },
        "optical_axis": {
          "$ref": "#/$defs/Fact"
        },
        "roll": {
          "$ref": "#/$defs/Fact"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "viewpoint_id",
        "shot_id",
        "viewing_task",
        "position",
        "height",
        "distance",
        "optical_axis",
        "roll",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "VisibilityTarget": {
