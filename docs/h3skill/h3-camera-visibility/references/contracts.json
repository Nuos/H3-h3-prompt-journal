          "minLength": 1
        },
        "priority": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "action_event_ref": {
          "$ref": "#/$defs/ActionRef"
        },
        "required_visibility": {
          "$ref": "#/$defs/Fact"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "target_id",
        "description",
        "priority",
        "action_event_ref",
        "required_visibility",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Framing": {
      "type": "object",
      "properties": {
        "framing_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
