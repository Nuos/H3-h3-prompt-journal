        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "framing_id",
        "shot_id",
        "viewpoint_ref",
        "shot_scale",
        "field_of_view",
        "composition",
        "targets",
        "visibility_assessment",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Focus": {
      "type": "object",
      "properties": {
        "focus_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
