  "sources": {
    "brief": {
      "kind": "user_requirement",
      "locator": "docs/h3skill/validation/m6/forward-use/dialogue-task.txt",
      "version": "1",
      "excerpt": "使用本仓库 docs/h3skill/h3-sound-music-dialogue 的技能，独立完成一段双人对话的声音计划。输入直接由用户提供，不要求执行其他核心模块。可以读取技能资源并使用离线工具；不得修改技能包。把请求、提案、组合结果、工具记录和最终说明存到 validation/m6/forward-use/dialogue/。\n\n镜头 SHOT-A：角色 ENTITY-CLERK 在画面内说：“先放在桌上，别松手。”\n镜头 SHOT-B：角色 ENTITY-VISITOR 说：“好，我接住了。”\n用户另指定 ENTITY-CLERK 的画外旁白：“这一次，我记住了。”，旁白时 ENTITY-CLERK 仍在画面中，没有开口表演。三句话必须保持用户给出的原字词和标点。声音事件顺序就是上述顺序；当前尚无绝对时刻、总片长和实际媒体。\n\n由用户给出的稳定身份：ENTITY-CLERK 是店员，ENTITY-VISITOR 是顾客。VOICE-REF 为已登记音色参考，明确只用于 ENTITY-VISITOR 的音色，不复制原信号，不复演其中台词。当前并未提供 VOICE-REF 的可听文件，不能描述已确认的音色质地。\n\n没有画外配乐。用户要求保留低声室内环境底声及事件 ACT-PLACE 的物件轻放声；ACT-PLACE 的动作由外部公开资料描述为顾客将盒子放在桌面并释放，当前没有具体时间。两镜之间环境底声连续；台词无需跨切。只设计本域声音，不制作动作计划、绝对时间轴或完整 H3 提示词。\n\n请按技能的公开合同提交可组合的声音计划，实际运行相关命令，并将剩余未知及交接信息列明。这些输入属于本轮设计任务数据，不是新收录的案例或媒体观察。\n"
    },
    "draft_assumption": {
      "kind": "hypothesis",
      "locator": "local-design://m6-forward-dialogue/provisional-shot-binding",
      "version": "1",
      "excerpt": "用户未指定旁白与 ACT-PLACE 所属镜头。仅为本轮可组合草稿暂挂 SHOT-B；不是已确认输入，交接前需确认或重绑定。"
    },
    "sound_design": {
      "kind": "design_decision",
      "locator": "local-design://m6-forward-dialogue/sound-requirements",
      "version": "1",
      "excerpt": "新设计声音，不复制 VOICE-REF 原信号。语音清晰自然，不推断音色质地、口音或节奏；环境底声低于语音，轻放声仅绑定桌面接触。"
    }
  },
