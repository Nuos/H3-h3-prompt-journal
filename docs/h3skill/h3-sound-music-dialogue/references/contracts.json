{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nuos/H3-h3-prompt-journal/docs/h3skill/h3-sound-music-dialogue/references/contracts.json",
  "title": "M6 SoundPlan public contracts",
  "description": "Portable closed contracts for sound sources, vocal events, music strategy and sound effects; timing, editing and final labels remain external.",
  "oneOf": [
    {
      "$ref": "#/$defs/M6Request"
    },
    {
      "$ref": "#/$defs/M6Proposal"
    },
    {
      "$ref": "#/$defs/M6ProposalBatch"
    },
    {
      "$ref": "#/$defs/M6State"
    }
  ],
  "$defs": {
    "Unknown": {
      "type": "object",
      "properties": {
        "state": {
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "NotApplicable": {
      "type": "object",
      "properties": {
        "state": {
          "const": "not_applicable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "KnownFact": {
      "type": "object",
      "properties": {
        "state": {
          "const": "known"
        },
        "value": {},
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "value",
        "source_refs"
      ],
      "additionalProperties": false,
      "description": "An asserted planning fact, not measured or generated-media verification. Its value is an opaque JSON payload."
    },
    "Fact": {
      "oneOf": [
        {
          "$ref": "#/$defs/KnownFact"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ]
    },
    "Brief": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "user_requirement",
            "approved_plan",
            "case_text",
            "external_input",
            "media_observation",
            "design_decision",
            "official_document",
            "hypothesis"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "locator",
        "version",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "Sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      }
    },
    "ExternalContext": {
      "type": "object",
      "properties": {
        "owner": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5",
            "M6",
            "M7",
            "M8",
            "M9",
            "M10",
            "M11",
            "M12",
            "M6.1",
            "M6.2",
            "M6.3",
            "M6.4",
            "external"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object"
        }
      },
      "required": [
        "owner",
        "source_id",
        "source_version",
        "values"
      ],
      "additionalProperties": false
    },
    "Projection": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(content|sources|issues)(/|$)"
        },
        "source_version": {
          "type": "integer",
          "minimum": 0
        },
        "value": {}
      },
      "required": [
        "path",
        "source_version",
        "value"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "owner": {
          "enum": [
            "M6.1",
            "M6.2",
            "M6.3",
            "M6.4"
          ]
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "severity": {
          "enum": [
            "blocking",
            "warning"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resolution": {
          "$ref": "#/$defs/KnownFact"
        }
      },
      "required": [
        "issue_id",
        "owner",
        "status",
        "severity",
        "message",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "issue_id",
        "rationale",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "M6Request": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "M6Request"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "target": {
          "enum": [
            "M6",
            "M6.1",
            "M6.2",
            "M6.3",
            "M6.4"
          ]
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        },
        "inputs": {
          "$ref": "#/$defs/Inputs"
        }
      },
      "required": [
        "kind",
        "contract_version",
        "work_id",
        "base_version",
        "request_id",
        "target",
        "sources",
        "inputs"
      ],
      "additionalProperties": false
    },
    "M6Proposal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "M6Proposal"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "module_id": {
          "enum": [
            "M6.1",
            "M6.2",
            "M6.3",
            "M6.4"
          ]
        },
        "source_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        },
        "context": {
          "$ref": "#/$defs/Inputs"
        },
        "changes": {
          "$ref": "#/$defs/Changes"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "minItems": 0
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resolution"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "contract_version",
        "work_id",
        "base_version",
        "proposal_id",
        "module_id",
        "source_request_id",
        "sources",
        "context",
        "changes",
        "issues",
        "resolutions"
      ],
      "additionalProperties": false
    },
    "M6ProposalBatch": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "M6ProposalBatch"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/M6Proposal"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "contract_version",
        "work_id",
        "base_version",
        "batch_id",
        "proposals"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "module_id": {
          "enum": [
            "M6.1",
            "M6.2",
            "M6.3",
            "M6.4"
          ]
        },
        "accepted_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "digest",
        "source_request_id",
        "module_id",
        "accepted_version"
      ],
      "additionalProperties": false
    },
    "Consumer": {
      "type": "object",
      "properties": {
        "module_id": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5",
            "M6",
            "M7",
            "M8",
            "M9",
            "M10",
            "M11",
            "M12",
            "M6.1",
            "M6.2",
            "M6.3",
            "M6.4"
          ]
        },
        "result_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/(content|sources|issues|display)(/|$)"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "current",
            "stale"
          ]
        }
      },
      "required": [
        "module_id",
        "result_version",
        "source_state_version",
        "read_paths",
        "status"
      ],
      "additionalProperties": false
    },
    "M6State": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "M6State"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "const": "M6"
        },
        "object_type": {
          "const": "SoundPlan"
        },
        "status": {
          "const": "draft"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "issues": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Issue"
          }
        },
        "accepted_proposals": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Receipt"
          }
        },
        "consumers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Consumer"
          }
        },
        "display": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "contract_version",
        "work_id",
        "version",
        "owner",
        "object_type",
        "status",
        "sources",
        "content",
        "issues",
        "accepted_proposals",
        "consumers"
      ],
      "additionalProperties": false
    },
    "Unverified": {
      "type": "object",
      "properties": {
        "state": {
          "const": "unverified"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "InternalRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "internal"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "ExternalRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "external"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "shot_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "shot_id",
        "source_id",
        "source_version"
      ],
      "additionalProperties": false
    },
    "PlanRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/InternalRef"
        },
        {
          "$ref": "#/$defs/ExternalRef"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ]
    },
    "Inputs": {
      "type": "object",
      "properties": {
        "sound_brief": {
          "$ref": "#/$defs/Brief"
        },
        "source_brief": {
          "$ref": "#/$defs/Brief"
        },
        "vocal_brief": {
          "$ref": "#/$defs/Brief"
        },
        "music_brief": {
          "$ref": "#/$defs/Brief"
        },
        "effects_brief": {
          "$ref": "#/$defs/Brief"
        },
        "source_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/SoundSources"
            },
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "vocal_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/VocalEvents"
            },
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "music_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/MusicPlans"
            },
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "effects_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/Effects"
            },
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "task_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "reference_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "space_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "action_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "camera_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "time_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "state_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "edit_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "label_context": {
          "oneOf": [
            {
              "$ref": "#/$defs/ExternalContext"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "readonly_projection": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Projection"
          },
          "minItems": 0
        },
        "vocal_texts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "audio_assets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/AudioAsset"
          }
        },
        "whole_track_silence": {
          "oneOf": [
            {
              "$ref": "#/$defs/KnownFact"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ]
        },
        "approved_vocal_texts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Changes": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sources": {
              "$ref": "#/$defs/SoundSources"
            }
          },
          "required": [
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "vocal_events": {
              "$ref": "#/$defs/VocalEvents"
            }
          },
          "required": [
            "vocal_events"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "music": {
              "$ref": "#/$defs/MusicPlans"
            }
          },
          "required": [
            "music"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "effects": {
              "$ref": "#/$defs/Effects"
            }
          },
          "required": [
            "effects"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Content": {
      "type": "object",
      "properties": {
        "sources": {
          "$ref": "#/$defs/SoundSources"
        },
        "vocal_events": {
          "$ref": "#/$defs/VocalEvents"
        },
        "music": {
          "$ref": "#/$defs/MusicPlans"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        }
      },
      "required": [
        "sources",
        "vocal_events",
        "music",
        "effects"
      ],
      "additionalProperties": false
    },
    "AssetIdentity": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "asset_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "asset_id",
        "asset_version"
      ],
      "additionalProperties": false
    },
    "Window": {
      "type": "object",
      "properties": {
        "start_seconds": {
